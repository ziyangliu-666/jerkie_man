{
  "name": "jerkie-man",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "server": "npm run dev:server",
    "dev:all": "node tools/select_map.mjs dev:all:raw",
    "dev:server": "node tools/select_map.mjs dev:server:raw",
    "dev:all:raw": "concurrently \"npm run dev:server:raw\" \"npm run dev:client\"",
    "dev:server:raw": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:urban": "MAP_TEMPLATE=urban_ruins npm run dev:server",
    "dev:forest": "MAP_TEMPLATE=forest_outpost npm run dev:server",
    "dev:example": "MAP_TEMPLATE=example npm run dev:server",
    "dev:33": "MAP_TEMPLATE=central_deadlock_1k npm run dev:server",
    "start:urban": "MAP_TEMPLATE=urban_ruins npm run start:server",
    "start:forest": "MAP_TEMPLATE=forest_outpost npm run start:server",
    "start:33": "MAP_TEMPLATE=central_deadlock_1k npm run start:server",
    "build": "npm run build --workspaces --if-present",
    "start:server": "node server/dist/main.js",
    "start:client": "npm run preview --workspace=client",
    "start:all": "node tools/select_map.mjs start:all:raw",
    "start:all:raw": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "restart:server": "npm run build && npm run start:server",
    "clean": "rimraf node_modules shared/node_modules server/node_modules client/node_modules shared/dist client/dist server/dist",
    "check:ci": "npm run build --workspace=shared && npm run build --workspace=client",
    "test:smoke": "npm run build --workspace=shared && tsx server/src/smoke.ts",
    "dump:key": "node tools/dump_key_code.mjs",
    "map:lint": "node tools/map_lint.mjs",
    "map:lint:all": "node tools/map_lint.mjs --all"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  }
}

